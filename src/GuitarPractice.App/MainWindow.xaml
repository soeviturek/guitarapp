<Window x:Class="GuitarPractice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:GuitarPractice.App.Controls"
        mc:Ignorable="d"
        Title="Guitar Practice"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F1218"
        Foreground="#EDF2F7"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#171C25" />
        <SolidColorBrush x:Key="BorderBrush" Color="#283140" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9EABBE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5FD3B4" />
        <SolidColorBrush x:Key="BlueBrush" Color="#488BFF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EDF2F7" />
            <Setter Property="Background" Value="#26303F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#344156" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#EDF2F7" />
            <Setter Property="Background" Value="#26303F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#344156" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D725F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDF2F7" />
            <Setter Property="Background" Value="#202733" />
            <Setter Property="BorderBrush" Value="#344156" />
            <Setter Property="CaretBrush" Value="#EDF2F7" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#11151C" />
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContent" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="154" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Guitar Practice" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="预设跟谱 · 多轨练习 · 区间循环 · 吉他录音" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ExerciseModeToggle"
                              Margin="0,0,12,0"
                              IsEnabled="False"
                              Content="预设练习"
                              Checked="ExerciseModeToggle_Changed"
                              Unchecked="ExerciseModeToggle_Changed" />
                <TextBlock Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="也可以把音频文件拖进窗口" />
                <Button Background="#2D725F"
                        Content="+ 导入音轨"
                        Click="ImportTracks_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayButton"
                            Width="90"
                            Background="#2D725F"
                            Content="▶ 播放"
                            Click="PlayPause_Click" />
                    <Button Width="70"
                            Content="■ 停止"
                            Click="Stop_Click" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="播放位置" />
                        <TextBlock x:Name="PositionLabel"
                                   Grid.Column="1"
                                   FontFamily="Consolas"
                                   Text="0:00.0 / 0:00.0" />
                    </Grid>
                    <Slider x:Name="PositionSlider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"
                            PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="[ 设起点"
                            ToolTip="快捷键：["
                            Click="SetLoopStart_Click" />
                    <Button Content="设终点 ]"
                            ToolTip="快捷键：]"
                            Click="SetLoopEnd_Click" />
                    <ToggleButton x:Name="LoopToggle"
                                  Margin="4,0,0,0"
                                  Content="循环"
                                  Checked="LoopToggle_Changed"
                                  Unchecked="LoopToggle_Changed" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="循环区间" />
                        <TextBlock x:Name="LoopRangeLabel"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Text="0:00.0 — 0:00.0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="AudioWorkspace" Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="音轨混音" />
                        <TextBlock x:Name="TrackCountLabel"
                                   Grid.Column="1"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="0 条" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TrackItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="#202733"
                                            CornerRadius="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBox Padding="0"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         FontWeight="SemiBold"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11">
                                                    <Run Text="{Binding KindDisplay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding DurationDisplay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Padding="8,5"
                                                    VerticalAlignment="Top"
                                                    Content="移除"
                                                    Tag="{Binding}"
                                                    Click="RemoveTrack_Click" />

                                            <Grid Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="音量" />
                                                <Slider Grid.Column="1"
                                                        Margin="9,0"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        Value="{Binding Volume}" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           Text="{Binding Volume, StringFormat={}{0:P0}}" />
                                                <ToggleButton Grid.Column="3"
                                                              Padding="9,5"
                                                              Content="静音"
                                                              IsChecked="{Binding IsMuted}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <controls:PracticeTimeline x:Name="Timeline"
                                               MinHeight="280"
                                               Cursor="Cross" />
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="8,5"
                            Background="#B011151C"
                            CornerRadius="5">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="拖动定位 · Shift + 拖动选择循环区间" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ExerciseWorkspace" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="内置练习" />
                        <ComboBox x:Name="ExercisePresetCombo"
                                  Margin="0,12,0,10"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ExercisePresetCombo_SelectionChanged" />
                        <TextBlock x:Name="ExerciseDescription"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,4" Text="练习速度（基准 120 BPM）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ExerciseSpeedSlider"
                                    Minimum="0.3333333333333333"
                                    Maximum="2"
                                    Value="0.6666666666666666"
                                    ValueChanged="ExerciseSpeedSlider_ValueChanged" />
                            <TextBlock x:Name="ExerciseSpeedLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontFamily="Consolas"
                                       Text="0.67×" />
                        </Grid>
                        <TextBlock Margin="0,3,0,12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="与下方 BPM 双向联动；只改变练习时长，不改变音高。r 表示休止。" />
                        <ToggleButton x:Name="ExerciseSoundToggle"
                                      IsChecked="True"
                                      Content="合成拨弦参考音"
                                      Checked="ExerciseSoundToggle_Changed"
                                      Unchecked="ExerciseSoundToggle_Changed" />
                        <Slider x:Name="ExerciseVolumeSlider"
                                Margin="0,10,0,14"
                                Minimum="0"
                                Maximum="1"
                                Value="0.55"
                                ToolTip="练习参考音音量"
                                ValueChanged="ExerciseVolumeSlider_ValueChanged" />
                        <Button Content="循环当前小节" Click="LoopExerciseMeasure_Click" />
                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="此模式暂停现有音轨，并暂不录音。关闭顶部“预设练习”会恢复原来的音轨、BPM 和循环区间。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ExercisePositionLabel"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="点击音符定位 · Shift + 拖动选择循环" />
                        <ToggleButton x:Name="ExerciseFollowToggle"
                                      Grid.Column="1"
                                      IsChecked="True"
                                      Padding="8,4"
                                      Content="跟随播放"
                                      Checked="ExerciseFollowToggle_Changed"
                                      Unchecked="ExerciseFollowToggle_Changed" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <controls:ExerciseTablature x:Name="Tablature" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MetronomeTitle" FontSize="15" FontWeight="SemiBold" Text="节拍器" />
                        <ToggleButton x:Name="MetronomeToggle"
                                      Grid.Column="1"
                                      Padding="10,5"
                                      Content="开启"
                                      Checked="MetronomeToggle_Changed"
                                      Unchecked="MetronomeToggle_Changed" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="BpmSlider"
                                Minimum="40"
                                Maximum="240"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="120"
                                ValueChanged="BpmSlider_ValueChanged" />
                        <TextBlock x:Name="BpmLabel"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   Text="120 BPM" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="节拍音量" />
                        <Slider x:Name="MetronomeVolumeSlider"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Minimum="0"
                                Maximum="1"
                                Value="0.65"
                                ValueChanged="MetronomeVolumeSlider_ValueChanged" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="吉他录音" />
                        <ToggleButton x:Name="RecordArmToggle"
                                      Grid.Column="1"
                                      Padding="10,5"
                                      Content="○ 待命"
                                      Checked="RecordArmToggle_Changed"
                                      Unchecked="RecordArmToggle_Changed" />
                    </Grid>
                    <ComboBox x:Name="RecordingInputCombo"
                              Grid.Row="1"
                              Margin="0,11,0,7"
                              DisplayMemberPath="Name"
                              SelectionChanged="RecordingInputCombo_SelectionChanged" />
                    <TextBlock x:Name="RecordingHint"
                               Grid.Row="2"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="勾选待命后按播放，录音会在暂停或停止时自动作为新音轨加入。" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="总输出" />
                    <TextBlock x:Name="MasterVolumeLabel"
                               Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="28"
                               Text="90%" />
                    <Slider x:Name="MasterVolumeSlider"
                            Grid.Row="2"
                            Minimum="0"
                            Maximum="1"
                            Value="0.9"
                            ValueChanged="MasterVolumeSlider_ValueChanged" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,6,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       Text="正在初始化音频设备…" />
            <TextBlock Grid.Column="1"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       Text="Space 播放/暂停 · [ ] 设置循环点 · R 录音待命" />
        </Grid>
    </Grid>
</Window>
