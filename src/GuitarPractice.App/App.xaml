<Application x:Class="GuitarPractice.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GuitarPractice.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#202733" />
            <Setter Property="Foreground" Value="#EDF2F7" />
            <Setter Property="BorderBrush" Value="#344156" />
        </Style>
    </Application.Resources>
</Application>
